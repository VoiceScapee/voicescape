# Voicescape env — copy to .env and fill in. NEVER commit real values.
# Frontend reads NEXT_PUBLIC_* vars; contracts/ and ipfs/ read the rest.

# ── Contracts (contracts/) ──────────────────────────────────────────────
# Treasury wallet receiving the 2% platform fee. Required by deploy script.
TREASURY_ADDRESS=
# Deployer private key — TEST key only, dedicated deploy wallet, never main funds.
DEPLOYER_PRIVATE_KEY=
# Optional RPC overrides (sane public defaults are baked into hardhat.config.js)
HEDERA_TESTNET_RPC=
HEDERA_MAINNET_RPC=
POLYGON_RPC_URL=
AMOY_RPC_URL=

# ── Frontend (frontend/) ────────────────────────────────────────────────
# Chain to target: hedera-testnet | hedera-mainnet | polygon-amoy | polygon
NEXT_PUBLIC_CHAIN=hedera-testnet
# Deployed contract addresses (fill after running scripts/deploy.js)
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_TIPS_ADDRESS=
# IPFS read gateway (default https://ipfs.io/ipfs/)
NEXT_PUBLIC_IPFS_GATEWAY=
# Optional browser-side RPC overrides
NEXT_PUBLIC_HEDERA_TESTNET_RPC=
NEXT_PUBLIC_HEDERA_MAINNET_RPC=
NEXT_PUBLIC_POLYGON_AMOY_RPC=
NEXT_PUBLIC_POLYGON_MAINNET_RPC=
# WalletConnect project id (required for Hedera wallet pairing via HashConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Vibecode AI editor — SERVER-SIDE ONLY, never expose to the browser
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── IPFS helper (frontend/lib/server/publish.js, served via /api/pin) ────
# Pinata-only pinning. The JWT stays SERVER-SIDE — the browser never sees it;
# the frontend pins by POSTing page JSON to /api/pin.
PINATA_JWT=
WEB3_STORAGE_TOKEN=
# Optional read-gateway host override (default ipfs.io)
IPFS_GATEWAY=
