# Blockchain / contracts
NEXT_PUBLIC_CHAIN=hedera-testnet
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TIPS_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: override RPC endpoints (defaults are public endpoints in lib/chains.ts)
NEXT_PUBLIC_HEDERA_TESTNET_RPC=
NEXT_PUBLIC_HEDERA_MAINNET_RPC=
NEXT_PUBLIC_POLYGON_AMOY_RPC=
NEXT_PUBLIC_POLYGON_MAINNET_RPC=
# IPFS read gateway (default https://ipfs.io/ipfs/)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Pinning: Pinata-only, via the server-side /api/pin route. The Pinata JWT is
# server-only (PINATA_JWT, see root .env.example) and never exposed here.
# AI vibecode chat — BYOK (bring your own key). Users paste their own
# Anthropic API key in the builder; it is stored only in their browser's
# localStorage and generation calls go directly from their browser to
# api.anthropic.com. The server never sees the key and never pays for
# generations, so no ANTHROPIC_API_KEY is needed here.
# (The x402 service optionally uses its own ANTHROPIC_API_KEY for its
# buyer-pays real-AI mode — see x402-vibecode/.env.example.)
# Pin quotas protecting the Pinata free tier (server-only).
PIN_MAX_PAGE_JSON_BYTES= # default 1048576 (1 MB)
PIN_DAILY_QUOTA=         # default 20 page pins / wallet / day
AUDIO_DAILY_QUOTA=       # default 3 audio uploads / wallet / day
# Free town-hall writes (votes, rep votes, listing status, mod actions,
# events) cost the operator an HCS submit fee each with no fee collected.
# Per-wallet daily cap (default 50); 429 past the limit. 0 = deny all.
TOWNHALL_WRITE_DAILY_QUOTA=
# WalletConnect (Hedera adapter) — public client id is fine in the browser
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Phase B: x402 pay-per-edit (builder AI tab) ---
# Full URL of the x402 vibecode endpoint, e.g. http://localhost:3000/vibecode
# (testnet) or the deployed mainnet URL. When unset, "Pay per edit (x402)"
# is disabled in the builder. Payment settles via the buyer's Hedera wallet.
NEXT_PUBLIC_X402_VIBECODE_URL=
# Optional: override the approximate HBAR/USD display rate used for USD
# conversions (tips, pay-per-call). Defaults to a CoinGecko lookup with a
# labeled 0.20 fallback. Display only — settlement always uses the 402 amount.
NEXT_PUBLIC_HBAR_USD_PRICE=

# --- Social Town Hall (HCS-backed forum/chat/votes/governance/market) ---
# User-signed architecture: users submit HCS messages directly via their
# wallet (paying the HCS fee themselves). No server operator key needed.
# HCS network for the Town Hall topics: testnet | previewnet | mainnet
TOWNHALL_HCS_NETWORK=testnet
# Topic ids — create them with `npm run townhall:init`, then paste the ids.
TOWNHALL_TOPIC_FORUM=
TOWNHALL_TOPIC_CHAT=
TOWNHALL_TOPIC_VOTES=
TOWNHALL_TOPIC_GOV=
TOWNHALL_TOPIC_MARKET=
# Default 2,000,000 tinybars = 0.02 HBAR ≈ $0.004 at ~$0.20/HBAR — a real
# per-write cost that prices out spam while staying cheap for real users.
# The fee goes to NEXT_PUBLIC_TREASURY_ADDRESS. Fee tx ids are single-use
# and must be paid by the signing wallet (server-verified via mirror node).
# The server REFUSES town-hall writes if the fee is 0 or below the operator's
# HCS submit cost (HCS_SUBMIT_FEE_TINYBARS, default 100000 tinybars).
DUST_FEE_TINYBARS=2000000
HCS_SUBMIT_FEE_TINYBARS=
# Treasury account (0.0.x) receiving dust fees (also used by the tips contract).
NEXT_PUBLIC_TREASURY_ADDRESS=
# Global Town Hall moderators: comma-separated registered usernames.
# They may post to the announcements board, create events, and hide any post.
TOWNHALL_MODS=

# --- Session tokens (REQUIRED in production) ---
# Canonical public origin (e.g. https://voicescape.app). Wallet sign-in
# messages are bound to this origin (EIP-4361 "uri") — a signature minted
# on a phishing site is rejected. Production REFUSES to verify sign-ins
# without it; dev warns and skips the check.
APP_ORIGIN=
# HMAC secret signing the stateless session tokens (7-day sessions).
# Generate with: openssl rand -hex 32
# Production REFUSES to issue/verify tokens without it. Keep server-only.
SESSION_SECRET=

# --- Shared quota/replay store (REQUIRED for multi-instance / Vercel) ---
# Free Upstash Redis (REST): 500k commands/month, 256 MB, no credit card.
# 1. upstash.com → create a free Redis database (any region near users).
# 2. Copy its REST URL and READ/WRITE token into the hosting env vars below.
# Without these the app runs in single-instance in-memory mode: quotas,
# dust-fee replay protection and sign-in nonces RESET ON RESTART and are
# NOT shared across instances (fine for local dev, NOT for production).
# If the store is unreachable at runtime, paid/operator-cost routes fail
# CLOSED (503) instead of running without limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Per-IP rate limits (second bound behind the per-wallet quotas) ---
# One IP cannot multiply per-wallet quotas across many wallets. Fixed
# windows over the shared store (memory fallback). 429 past the limit.
IP_RATE_LIMIT_WINDOW_MS=  # default 3600000 (1 hour)
IP_RATE_LIMIT_PIN=       # default 120 pin requests / IP / window
IP_RATE_LIMIT_TOWNHALL=  # default 300 town-hall writes / IP / window
