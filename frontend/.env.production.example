# Voicescape frontend — PRODUCTION (Hedera mainnet) env template
#
# Copy these into your hosting provider's environment variables
# (Vercel: Project Settings → Environment Variables → Production).
# NEVER commit real values to git.

# --- Chain & contracts (fill after running contracts/scripts/deploy.js) ---
NEXT_PUBLIC_CHAIN=hedera-mainnet
# Canonical public origin of the app, e.g. https://voicescape.app
# SECURITY: wallet sign-in messages are bound to this origin (EIP-4361 "uri").
# A signature minted on a phishing site is rejected when this is set. Leave
# it UNSET only for local dev — production must set it.
APP_ORIGIN=
NEXT_PUBLIC_REGISTRY_ADDRESS=0xPASTE_REGISTRY_ADDRESS_HERE
NEXT_PUBLIC_TIPS_ADDRESS=0xPASTE_TIPS_ADDRESS_HERE

# --- RPC (optional; defaults are the public endpoints in lib/chains.ts) ---
NEXT_PUBLIC_HEDERA_MAINNET_RPC=

# --- IPFS ---
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Server-only. Get a free key at pinata.cloud, paste into hosting env as PINATA_JWT.
PINATA_JWT=

# --- AI vibecode (BYOK — bring your own key) ---
# Users paste their own Anthropic API key in the builder's "My AI key" tab.
# The key is stored only in their browser's localStorage; generation calls go
# directly from their browser to api.anthropic.com. The server never sees the
# key and never pays for generations — no ANTHROPIC_API_KEY needed here.
# (The x402 service optionally uses its own ANTHROPIC_API_KEY for its
# buyer-pays real-AI mode — see x402-vibecode/.env.example.)

# --- IPFS pin quotas (server-only; defaults protect the Pinata free tier) ---
PIN_MAX_PAGE_JSON_BYTES= # default 1048576 (1 MB)
PIN_DAILY_QUOTA=         # default 20 page pins / wallet / day
AUDIO_DAILY_QUOTA=       # default 3 audio uploads / wallet / day

# --- Free town-hall write quota (server-only) --------------------------------
# Votes, rep votes, listing status changes, mod actions and events require no
# dust fee but each costs the operator an HCS submit fee. Per-wallet daily cap
# (default 50); the handler returns 429 past the limit. 0 = deny all.
TOWNHALL_WRITE_DAILY_QUOTA=

# --- WalletConnect (Hedera adapter). Free project ID at cloud.walletconnect.com ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Phase B: x402 pay-per-edit (builder AI tab) ---
# Full URL of the deployed x402 vibecode endpoint (mainnet). Unset = disabled.
NEXT_PUBLIC_X402_VIBECODE_URL=
# Optional display-rate override for USD conversions (see .env.example).
NEXT_PUBLIC_HBAR_USD_PRICE=

# --- Social Town Hall (HCS-backed forum/chat/votes/governance/market) ---
# Server-only operator that submits Town Hall HCS messages. NEVER expose to
# the browser; paste real values into the hosting env, never into git.
TOWNHALL_OPERATOR_ID=
TOWNHALL_OPERATOR_KEY=
TOWNHALL_HCS_NETWORK=mainnet
# Topic ids — create ONCE with `npm run townhall:init` (only after Brandon's
# explicit go on mainnet), then paste the ids.
TOWNHALL_TOPIC_FORUM=
TOWNHALL_TOPIC_CHAT=
TOWNHALL_TOPIC_VOTES=
TOWNHALL_TOPIC_GOV=
TOWNHALL_TOPIC_MARKET=
# Dust fee per forum post / chat message / proposal / listing (tinybars).
# Default 2,000,000 tinybars = 0.02 HBAR ≈ $0.004 at ~$0.20/HBAR (anti-spam).
# The server REFUSES town-hall writes if this is 0 or below the operator's
# HCS submit cost — the platform never subsidizes writes.
DUST_FEE_TINYBARS=2000000
# Operator's assumed per-message HCS submit cost, tinybars (default 100000,
# ≈2x the real ~$0.0001). The dust-fee guard uses this; raise if fees rise.
HCS_SUBMIT_FEE_TINYBARS=
NEXT_PUBLIC_TREASURY_ADDRESS=
# Global Town Hall moderators: comma-separated registered usernames.
TOWNHALL_MODS=

# --- Session tokens (REQUIRED in production) --------------------------------
# HMAC secret signing the stateless session tokens. Generate with:
#   openssl rand -hex 32
# Production REFUSES to issue or verify session tokens without it.
# Server-only — paste into the hosting env, never into git.
SESSION_SECRET=

# --- Shared quota/replay store (REQUIRED for production) --------------------
# Free Upstash Redis (REST): 500k commands/month, 256 MB, no credit card.
# Without these, quotas / dust-fee replay protection / sign-in nonces are
# per-instance memory only: a restart resets them and Vercel's multiple
# instances would not share them. Paid routes fail CLOSED (503) when the
# store is unreachable, so a Redis outage pauses writes instead of
# letting them run unlimited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Per-IP rate limits (server-only; defaults are sane) --------------------
IP_RATE_LIMIT_WINDOW_MS=  # default 3600000 (1 hour)
IP_RATE_LIMIT_PIN=       # default 120 / IP / window
IP_RATE_LIMIT_TOWNHALL=  # default 300 / IP / window
