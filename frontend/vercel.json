{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/pin/route.ts": { "maxDuration": 60 },
    "app/api/townhall/chat/[room]/stream/route.ts": { "maxDuration": 60 },
    "app/api/vibecode/route.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/((?!_next/static|_next/image|favicon.ico|icon.svg|manifest.json).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
