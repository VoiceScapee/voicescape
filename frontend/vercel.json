{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/pin/route.ts": {
      "maxDuration": 60
    },
    "app/api/townhall/chat/[room]/stream/route.ts": {
      "maxDuration": 60
    },
    "app/api/vibecode/route.ts": {
      "maxDuration": 60
    },
    "app/api/agent/chat/route.ts": {
      "maxDuration": 60
    },
    "app/api/agent/chat/build-job/route.ts": {
      "maxDuration": 60
    },
    "app/api/webhooks/poll/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/_next/static/:path*"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.hashio.io https://*.mirrornode.hedera.com https://api.anthropic.com https://api.otari.ai https://openrouter.ai https://api.groq.com https://api.openai.com https://api.coingecko.com https://open.er-api.com https://ipfs.io https://gateway.pinata.cloud https://*.mypinata.cloud wss://*.walletconnect.com https://*.walletconnect.com https://*.walletconnect.org https://*.reown.com https://pulse.walletconnect.org https://api.web3modal.org https://voicescape-x402-vibecode.onrender.com; frame-src 'self' https://www.youtube.com https://w.soundcloud.com https://open.spotify.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/:path*"
    },
    {
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ],
      "source": "/agent-manifest.json"
    },
    {
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ],
      "source": "/voicescape_assistant.network.json"
    },
    {
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ],
      "source": "/links.json"
    },
    {
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ],
      "source": "/agent-mcp.json"
    },
    {
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ],
      "source": "/.well-known/nsdeploy.json"
    },
    {
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ],
      "source": "/.well-known/nsdeploy-agent.json"
    },
    {
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src blob:; connect-src 'none'; worker-src 'none'"
        }
      ],
      "source": "/runtime/sandbox-worker.js"
    }
  ],
  "crons": [
    {
      "path": "/api/webhooks/poll",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/vault/watch/scan",
      "schedule": "17 8 * * *"
    }
  ]
}
